{
  "compilerOptions": {
    "module": "ESNext",
    "outDir": "./dist",
    "rootDir": "./",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit" : true,
    "allowImportingTsExtensions" : true
  }
}
